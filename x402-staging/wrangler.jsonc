{
  "name": "oseille-x402-sepolia-staging",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "preview_urls": false,
  "observability": { "enabled": true, "traces": { "enabled": true, "head_sampling_rate": 0.01 } },
  "durable_objects": { "bindings": [{ "name": "PAYMENTS", "class_name": "TestnetPayments" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["TestnetPayments"] }],
  "vars": {
    "X402_ENABLED": "false",
    "X402_RECIPIENT": ""
  }
}
